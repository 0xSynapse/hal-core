# HAL Core WireGuard Tunnel for Remote/Laptop Agents (wg0 / wg-agent)
# Copy to /usr/local/etc/wireguard/wg0.conf (chmod 0600) and fill in real keys.
#
# In rc.conf:
#   wireguard_enable="YES"
#   wireguard_interfaces="wg0 wg1"

[Interface]
PrivateKey = REPLACE_WITH_HAL_CORE_WG0_PRIVATE_KEY
Address = 10.99.0.1/24
ListenPort = 51820

# Matches `remote-laptop-01` in /usr/local/etc/hal-os/gateway-peers.toml
[Peer]
PublicKey = REPLACE_WITH_LAPTOP_WG_PUBLIC_KEY
AllowedIPs = 10.99.0.10/32
PersistentKeepalive = 25
