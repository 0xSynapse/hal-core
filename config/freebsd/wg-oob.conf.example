# HAL Key WireGuard Tunnel for Operator Phone / Browser Out-of-Band Access (wg1 / wg-oob)
# Copy to /usr/local/etc/wireguard/wg1.conf (chmod 0600) and fill in real keys.
# Traffic on wg1 can reach hal-oob (port 8443) and operator SSH, invisible to all cognitive Jails.

[Interface]
PrivateKey = REPLACE_WITH_HAL_CORE_WG1_PRIVATE_KEY
Address = 10.100.0.1/24
ListenPort = 51821

# Operator Phone ("HAL Key")
[Peer]
PublicKey = REPLACE_WITH_PHONE_HAL_KEY_PUBLIC_KEY
AllowedIPs = 10.100.0.10/32
PersistentKeepalive = 25
